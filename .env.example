# ==============================================================================
# ARTENÓS - ARQUIVO DE EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env.example)
# NUNCA insira chaves reais neste arquivo.
# Copie este arquivo para .env e preencha com as credenciais do seu projeto.
# ==============================================================================

# Variáveis públicas permitidas no frontend:
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_placeholder"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_placeholder"
VITE_SUPABASE_ANON_KEY="sb_publishable_placeholder"
VITE_APP_URL="http://localhost:3000"

# Variáveis privadas, exclusivas do servidor ou Supabase Edge Functions:
SUPABASE_SERVICE_ROLE_KEY="sb_secret_placeholder"
MERCADOPAGO_ACCESS_TOKEN="APP_USR_placeholder"
MERCADOPAGO_WEBHOOK_SECRET="whsec_placeholder"
PAGARME_API_KEY="ak_live_placeholder"
PAGARME_WEBHOOK_SECRET="whsec_placeholder"
ANTIFRAUD_API_KEY="af_key_placeholder"
REDIS_URL="rediss://default:token@host:6379"
REDIS_TOKEN="redis_token_placeholder"
