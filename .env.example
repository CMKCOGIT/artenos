# ==============================================================================
# ARTENÓS — MODELO DE VARIÁVEIS DE AMBIENTE (.env.example)
# NUNCA insira chaves ou segredos reais neste arquivo.
# Copie para .env e preencha com as credenciais do seu projeto.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VARIÁVEIS PÚBLICAS (Frontend / Vite)
# Acessíveis com segurança no navegador com prefixo VITE_
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua_chave_anonima_publicavel_aqui"
VITE_APP_URL="http://localhost:3000"

# Compatibilidade (Next.js / Scripts)
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sua_chave_anonima_publicavel_aqui"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. VARIÁVEIS PRIVADAS (Servidor / Supabase Edge Functions)
# NUNCA devem ser expostas ou acessadas no navegador
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY="sua_chave_service_role_aqui"
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
PAGARME_API_KEY=""
PAGARME_WEBHOOK_SECRET=""
ANTIFRAUD_API_KEY=""
REDIS_URL=""
REDIS_TOKEN=""
